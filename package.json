{
  "name": "aria-fault-or-discovery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1 --port 43173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 43173",
    "lint": "eslint",
    "test:aria": "npx tsx src/lib/aria/verify.ts",
    "test:paper": "npx tsx src/lib/aria/paper_eval.ts",
    "test:gbm": "npx tsx src/lib/aria/real_eval.ts",
    "test:gbm:heldout": "npx tsx src/lib/aria/real_eval_heldout.ts",
    "test:gbm:cv": "npx tsx src/lib/aria/real_eval_cv.ts",
    "test:bound": "npx tsx src/lib/aria/verify_bound.ts",
    "test:extra": "npx tsx src/lib/aria/extra_eval.ts",
    "test:fusion": "npx tsx src/lib/aria/fusion_eval.ts",
    "test:channel": "npx tsx src/lib/aria/channel_id.ts",
    "test:conv": "npx tsx src/lib/aria/conv_checksum.ts",
    "test:poisson": "npx tsx src/lib/aria/poisson_filter.ts",
    "test:figures": "npx tsx src/lib/aria/dump_figures.ts",
    "figures:check": "npx tsx src/lib/aria/check_figures.ts && python3 paper/make_check_figures.py paper",
    "test:checkmodes": "ARIA_CHECK=bounded npx tsx src/lib/aria/paper_eval.ts && npx tsx src/lib/aria/real_compare.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "^15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
